NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs short-lived "phone just verified" tokens (src/lib/verify-token.ts).
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=

# On the SITE side, so it knows where to call the Windows PC:
SMS_SERVICE_URL=             # e.g. https://verify.srtcuts.hair (your Cloudflare Tunnel URL)
SMS_SERVICE_TOKEN=            # same shared secret as the Windows PC's SMS_SERVICE_TOKEN below

ADMIN_PHONE=
NEXT_PUBLIC_SITE_URL=https://srtcuts.hair

AUTH_ADMIN_BYPASS_CODE=
AUTH_CUSTOMER_BYPASS_CODE=

# --- Windows PC only (sms-service/server.ts) — not needed by the site itself ---
# Free email-to-SMS gateway path (src/lib/sms-gateway.ts)
NUMLOOKUP_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMS_SERVICE_PORT=8787
# SMS_SERVICE_TOKEN= (same value as above, long random secret e.g. `openssl rand -hex 32`)
