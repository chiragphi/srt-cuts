NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs short-lived "phone just verified" tokens (src/lib/verify-token.ts).
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=

# Where the standalone verification service lives (runs separately, e.g. on
# a Windows PC — see the srt-verify-service package) and the shared secret
# it expects on every request. Must match that service's SMS_SERVICE_TOKEN.
SMS_SERVICE_URL=             # e.g. https://verify.srtcuts.hair
SMS_SERVICE_TOKEN=

ADMIN_PHONE=
NEXT_PUBLIC_SITE_URL=https://srtcuts.hair

AUTH_ADMIN_BYPASS_CODE=
AUTH_CUSTOMER_BYPASS_CODE=
