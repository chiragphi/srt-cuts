NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs short-lived "phone just verified" tokens (src/lib/verify-token.ts).
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=

# SMS_PROVIDER=mac sends through this Mac's Messages app and keeps the Mac
# awake while the server process is alive. Change to textbelt when ready.
SMS_PROVIDER=mac
MAC_SMS_KEEP_AWAKE=true

# Textbelt SMS API key (https://textbelt.com) — prepaid credits, ~$0.01/text.
# Used when SMS_PROVIDER=textbelt.
TEXTBELT_API_KEY=

ADMIN_PHONE=
NEXT_PUBLIC_SITE_URL=https://srtcuts.hair

AUTH_ADMIN_BYPASS_CODE=
AUTH_CUSTOMER_BYPASS_CODE=
